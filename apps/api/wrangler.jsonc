// Cloudflare Worker de la API (PLAN.md §6). Sin secretos aquí:
// SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, etc. se cargan con `wrangler secret put` (RNF-S04).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atalia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Cron cada minuto: libera cupos vencidos (respaldo de checkout.session.expired) y publica el sitio si el
  // panel cambió algo (DEPLOY_HOOK_URL, secreto).
  "triggers": { "crons": ["* * * * *"] },
  // Límites por IP (RNF-S06). period solo admite 10 o 60 s. Estricto: pagar, cotizar y el panel.
  "ratelimits": [
    { "name": "RL_STRICT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_NORMAL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321,http://127.0.0.1:4322",
    "ADMIN_URL": "http://127.0.0.1:4322/",
    "SITE_URL": "http://127.0.0.1:4321",
    // Remitente de los correos (no es secreto): dominio de la clienta, verificado en su cuenta de Resend.
    "EMAIL_FROM": "Atalia Café <ataliacafe@ataliacafe.com>",
    // Clave de PRUEBA pública de Cloudflare Turnstile (siempre pasa). En staging/producción va como secreto.
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
  },
  "env": {
    "staging": {
      "name": "atalia-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "",
        "EMAIL_FROM": "Atalia Café <ataliacafe@ataliacafe.com>",
      },
    },
  },
}
