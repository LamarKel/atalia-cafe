# Copia como .env. Solo la clave pública "publishable" de Supabase; nunca la service_role.
PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_...

# URL del Worker (API). En desarrollo: wrangler dev.
PUBLIC_API_URL=http://127.0.0.1:8787

# Cloudflare Turnstile (anti-bots). Esta es la clave de PRUEBA pública que siempre pasa.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
