---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import CheckoutHeader from '../components/CheckoutHeader.astro'
import Header from '../components/Header.astro'
import MobileNav from '../components/MobileNav.astro'
import { getSiteContent, getStoreInfo } from '../lib/catalog'
import { localizedPath, t, type Locale } from '../i18n'
// Las dos fuentes que se ven primero (títulos y texto), precargadas: el primer pintado ya sale con la marca
import headingFont from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url'
import bodyFont from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url'

interface Props {
  locale: Locale
  title?: string | undefined
  description?: string | undefined
  /** Checkout y confirmación (diseños 05 y 06): encabezado mínimo, sin pie ni barra inferior. */
  checkout?: boolean
}

const { locale, title, description, checkout = false } = Astro.props
const currentPath = Astro.url.pathname
const pageTitle = title ? `${title} · ${t(locale, 'brand.name')}` : t(locale, 'brand.name')
const site = Astro.site ?? new URL('https://atalia.cafe')
const [store, content] = await Promise.all([getStoreInfo(), getSiteContent(locale)])
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Animaciones del inicio: ocultar antes de pintar lo que Motion va a mostrar (ver global.css). -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const d = document.documentElement
        d.setAttribute('data-motion-pending', '')
        setTimeout(function () {
          if (d.dataset.motion !== 'on') d.removeAttribute('data-motion-pending')
        }, 3000)
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t(locale, 'meta.description')} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPath(currentPath, 'en'), site)} />
    <link rel="alternate" hreflang="es" href={new URL(localizedPath(currentPath, 'es'), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(currentPath, 'en'), site)} />
    <link rel="icon" href={store.faviconUrl ?? '/favicon.png'} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-secondary px-4 py-2 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      {t(locale, 'a11y.skip_to_content')}
    </a>
    {checkout ? <CheckoutHeader locale={locale} /> : <Header locale={locale} currentPath={currentPath} />}
    <main id="main">
      <slot />
    </main>
    {
      !checkout && (
        <>
          <Footer locale={locale} store={store} tagline={content['footer.tagline']} />
          <MobileNav locale={locale} currentPath={currentPath} />
        </>
      )
    }
  </body>
</html>
