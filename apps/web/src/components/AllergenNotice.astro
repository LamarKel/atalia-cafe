---
// Aviso de alérgenos (site_content legal.allergens, editable en el panel).
import { getSiteContent } from '../lib/catalog'
import type { Locale } from '../i18n'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props
const notice = (await getSiteContent(locale))['legal.allergens']
---

{notice && <p class:list={['mx-auto max-w-7xl px-4 text-sm text-muted md:px-8', className]}>{notice}</p>}
