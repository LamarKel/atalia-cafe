---
// "¿Tienes un evento?" (inicio v2 y Nosotros): pedir catering, WhatsApp (si hay número) y cotización.
import type { StoreInfo } from '../../lib/catalog'
import { localizedPath, t, type Locale } from '../../i18n'
import RichTitle from './RichTitle.astro'

interface Props {
  locale: Locale
  c: Record<string, string>
  store: StoreInfo
}

const { locale, c, store } = Astro.props
const whatsappUrl = store.whatsapp ? `https://wa.me/${store.whatsapp}` : null
---

{
  c['home.cta.title'] && (
    <section class="pb-20 md:pb-28" aria-labelledby="cta-title" data-reveal>
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="flex flex-col gap-10 rounded-[40px] bg-primary-ink px-7 py-12 text-white md:px-16 md:py-16 lg:flex-row lg:items-center lg:justify-between">
          <div class="grid gap-4" data-reveal-item>
            <h2
              id="cta-title"
              class="font-heading text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl"
            >
              <RichTitle text={c['home.cta.title']} emClass="text-white" />
            </h2>
            {c['home.cta.subtitle'] && <p class="max-w-xl text-lg">{c['home.cta.subtitle']}</p>}
          </div>
          <div class="grid gap-3 sm:min-w-64" data-reveal-item>
            <a
              href={localizedPath('/catering', locale)}
              class="inline-flex min-h-14 items-center justify-center rounded-full bg-white px-8 font-semibold text-dark transition-transform motion-safe:hover:-translate-y-0.5"
            >
              {c['home.cta.primary'] ?? t(locale, 'nav.order_catering')}
            </a>
            {whatsappUrl && c['home.cta.whatsapp'] && (
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-14 items-center justify-center rounded-full border-[1.5px] border-white px-8 font-semibold transition-transform motion-safe:hover:-translate-y-0.5"
              >
                {c['home.cta.whatsapp']}
              </a>
            )}
            <a
              href={localizedPath('/quote', locale)}
              class="inline-flex min-h-11 items-center justify-center font-semibold underline underline-offset-4"
            >
              {t(locale, 'nav.quote')}
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
