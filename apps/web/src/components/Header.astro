---
// Encabezado del diseño aprobado (docs/design/01-inicio.png): logo, navegación, idioma, carrito y CTA.
// En móvil y tablet, la navegación va en un menú hamburguesa.
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import CartLink from '../islands/CartLink'
import { localizedPath, otherLocale, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
  currentPath: string
}

const { locale, currentPath } = Astro.props
const other = otherLocale(locale)

const links = [
  { href: '/', label: t(locale, 'nav.home') },
  { href: '/catering', label: t(locale, 'nav.catering') },
  { href: '/menu', label: t(locale, 'nav.menu') },
  { href: '/about', label: t(locale, 'nav.about') },
  { href: '/contact', label: t(locale, 'nav.contact') },
] as const

const basePath = localizedPath(currentPath, 'en')
const isActive = (href: string) => (href === '/' ? basePath === '/' : basePath.startsWith(href))
---

<header class="sticky top-0 z-40 border-b border-dark/5 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 md:h-20 md:px-8">
    <a
      href={localizedPath('/', locale)}
      class="flex min-h-11 items-center gap-2"
      aria-label={t(locale, 'a11y.home')}
    >
      <Image
        src={logo}
        alt=""
        width={40}
        height={40}
        class="size-9 object-contain md:size-10"
        loading="eager"
      />
      <span class="font-heading text-xl font-bold text-secondary md:text-2xl">{t(locale, 'brand.name')}</span>
    </a>

    <nav aria-label={t(locale, 'a11y.main_nav')} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={localizedPath(link.href, locale)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center border-b-2 text-[15px] font-medium transition-colors hover:text-secondary',
                  isActive(link.href) ? 'border-secondary text-secondary' : 'border-transparent text-dark',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href={localizedPath(currentPath, other)}
        hreflang={other}
        lang={other}
        class="inline-flex min-h-11 items-center rounded-full border border-dark/15 px-4 text-sm font-medium hover:border-secondary"
        aria-label={`${t(locale, 'a11y.language')}: ${t(locale, 'lang.switch_to')}`}
      >
        <span aria-hidden="true">{t(locale, 'lang.code_current')} · {t(locale, 'lang.code_other')}</span>
      </a>
      <div class="hidden md:block">
        <CartLink
          client:idle
          href={localizedPath('/cart', locale)}
          label={t(locale, 'nav.cart')}
          countLabel={t(locale, 'a11y.cart_count')}
          variant="pill"
        />
      </div>
      <a href={localizedPath('/catering', locale)} class="btn-primary hidden !py-2.5 text-sm lg:inline-flex">
        {t(locale, 'nav.order_catering')}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-11 items-center justify-center rounded-full border border-dark/15 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t(locale, 'a11y.open_menu')}
        data-label-open={t(locale, 'a11y.open_menu')}
        data-label-close={t(locale, 'a11y.close_menu')}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path data-icon="open" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
          <path data-icon="close" class="hidden" d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label={t(locale, 'a11y.main_nav')}
    class="hidden border-t border-dark/5 bg-white px-4 pb-6 pt-2 shadow-md lg:hidden"
  >
    <ul class="divide-y divide-dark/5">
      {
        links.map((link) => (
          <li>
            <a
              href={localizedPath(link.href, locale)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-12 items-center text-lg font-medium',
                isActive(link.href) ? 'text-secondary' : 'text-dark',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <!-- Solo en el menú del teléfono: la barra de escritorio queda igual al diseño aprobado -->
      <li>
        <a
          href={localizedPath('/quote', locale)}
          aria-current={isActive('/quote') ? 'page' : undefined}
          class:list={[
            'flex min-h-12 items-center text-lg font-medium',
            isActive('/quote') ? 'text-secondary' : 'text-dark',
          ]}
        >
          {t(locale, 'nav.quote')}
        </a>
      </li>
    </ul>
    <a href={localizedPath('/catering', locale)} class="btn-primary mt-4 w-full">
      {t(locale, 'nav.order_catering')}
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open))
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '')
      menu.classList.toggle('hidden', !open)
      button.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open)
      button.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open)
    }
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        button.focus()
      }
    })
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
  }
</script>
