---
// Encabezado del checkout (diseños 05 y 06): solo el logo y "Pago seguro con Stripe", sin distracciones.
import { Image } from 'astro:assets'
// Solo la taza del logo: el nombre ya va escrito al lado (el logo ancho no cabe en un cuadrado)
import logo from '../assets/logo-cup.png'
import { localizedPath, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<header class="border-b border-dark/5 bg-white">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 md:h-20 md:px-8">
    <a
      href={localizedPath('/', locale)}
      class="flex min-h-11 items-center gap-2"
      aria-label={t(locale, 'a11y.home')}
    >
      <Image
        src={logo}
        alt=""
        width={40}
        height={40}
        class="size-9 object-contain md:size-10"
        loading="eager"
      />
      <span class="font-heading text-xl font-bold text-secondary md:text-2xl">{t(locale, 'brand.name')}</span>
    </a>
    <p class="flex items-center gap-2 text-sm text-muted">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <rect x="5" y="11" width="14" height="10" rx="2"></rect>
        <path d="M8 11V8a4 4 0 0 1 8 0v3" stroke-linecap="round"></path>
      </svg>
      {t(locale, 'checkout.secure')}
    </p>
  </div>
</header>
