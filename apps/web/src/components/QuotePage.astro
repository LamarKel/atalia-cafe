---
// "Pide una cotización" (PLAN.md RF-Q01–Q05). Productos de interés desde la BD; el formulario es una isla.
import QuoteForm from '../islands/QuoteForm'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCateringProducts } from '../lib/catalog'
import { localizedPath, messagesFor, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const products = (await getCateringProducts(locale)).map((p) => ({ id: p.id, name: p.name }))
---

<BaseLayout locale={locale} title={t(locale, 'quote.title')} description={t(locale, 'quote.subtitle')}>
  <div class="mx-auto max-w-7xl px-4 pb-24 pt-10 md:px-8 md:pt-14">
    <div class="mx-auto mb-8 max-w-3xl">
      <h1 class="font-heading text-4xl font-bold text-dark md:text-5xl">{t(locale, 'quote.title')}</h1>
      <p class="mt-3 text-lg text-muted">{t(locale, 'quote.subtitle')}</p>
    </div>
    <QuoteForm
      client:load
      locale={locale}
      messages={messagesFor(locale)}
      products={products}
      turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
      cateringHref={localizedPath('/catering', locale)}
    />
  </div>
</BaseLayout>
