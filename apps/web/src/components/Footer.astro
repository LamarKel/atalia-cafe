---
// Pie de página del diseño aprobado (docs/design/01-inicio.png): fondo café, 4 columnas.
// Todo el contenido viene de la BD (business_settings, stores, business_hours, site_content).
import { directionsUrl, groupHours } from '../lib/catalog-format'
import type { StoreInfo } from '../lib/catalog'
import { localizedPath, t, type Locale, type MessageKey } from '../i18n'

interface Props {
  locale: Locale
  store: StoreInfo
  tagline?: string | undefined
}

const { locale, store, tagline } = Astro.props
const year = new Date().getFullYear()
const hours = groupHours(store.hours)
const directions = directionsUrl(store.lat, store.lng)
const dayName = (d: number) => t(locale, `day.${d}` as MessageKey)
const dayRange = (days: number[]) =>
  days.length > 1 ? `${dayName(days[0] ?? 0)}–${dayName(days.at(-1) ?? 0)}` : dayName(days[0] ?? 0)
const whatsappUrl = store.whatsapp ? `https://wa.me/${store.whatsapp}` : null
---

<footer class="bg-secondary pb-28 pt-14 text-white md:pb-12">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:grid-cols-2 md:px-8 lg:grid-cols-4">
    <div>
      <p class="font-heading text-2xl font-bold">{store.businessName}</p>
      {tagline && <p class="mt-2 text-white/85">{tagline}</p>}
    </div>

    <div>
      <h2 class="font-semibold">{t(locale, 'footer.hours')}</h2>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-white/85">
        {
          hours.map((group) => (
            <div class="contents">
              <dt>{dayRange(group.days)}</dt>
              <dd>{group.text ?? t(locale, 'footer.closed')}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <h2 class="font-semibold">{t(locale, 'footer.location')}</h2>
      {store.address && <p class="mt-3 text-white/85">{store.address}</p>}
      {
        directions && (
          <a
            href={directions}
            target="_blank"
            rel="noopener"
            class="mt-1 inline-flex min-h-11 items-center font-semibold underline underline-offset-4"
          >
            {t(locale, 'footer.directions')}
          </a>
        )
      }
    </div>

    <div>
      <h2 class="font-semibold">{t(locale, 'footer.contact')}</h2>
      <p class="mt-3 flex flex-wrap gap-x-2 text-white/85">
        {
          store.phone && (
            <a href={`tel:${store.phone}`} class="inline-flex min-h-11 items-center">
              {store.phone}
            </a>
          )
        }
        {
          store.phone && whatsappUrl && (
            <span aria-hidden="true" class="inline-flex min-h-11 items-center">
              ·
            </span>
          )
        }
        {
          whatsappUrl && (
            <a href={whatsappUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center">
              WhatsApp
            </a>
          )
        }
      </p>
      <a
        href={localizedPath('/policies', locale)}
        class="inline-flex min-h-11 items-center underline underline-offset-4"
      >
        {t(locale, 'footer.policies')}
      </a>
    </div>
  </div>

  <p class="mx-auto mt-10 max-w-7xl border-t border-white/15 px-4 pt-6 text-sm text-white/75 md:px-8">
    © {year}
    {store.businessName}. {t(locale, 'footer.rights')}
  </p>
</footer>
