---
// Checkout (docs/design/05-checkout-cuando.png). Todo lo interactivo vive en CheckoutFlow (lee el carrito local).
import CheckoutFlow from '../islands/CheckoutFlow'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPickupStores, getSiteContent } from '../lib/catalog'
import { localizedPath, messagesFor, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const [stores, content] = await Promise.all([getPickupStores(locale), getSiteContent(locale)])
---

<BaseLayout locale={locale} title={t(locale, 'checkout.title')} checkout>
  <div class="mx-auto max-w-7xl px-4 pb-24 pt-8 md:px-8 md:pt-10">
    <CheckoutFlow
      client:only="react"
      locale={locale}
      messages={messagesFor(locale)}
      cartHref={localizedPath('/catering', locale)}
      stores={stores}
      legal={{
        terms: localizedPath('/terms', locale),
        privacy: localizedPath('/privacy', locale),
        policies: localizedPath('/policies', locale),
      }}
      allergenNotice={content['legal.allergens'] ?? null}
    />
  </div>
</BaseLayout>
