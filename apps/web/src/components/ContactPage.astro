---
// Contacto: a la izquierda el título y las formas rápidas de contactar (llamar, WhatsApp, correo, redes),
// fija mientras se baja por el formulario; a la derecha el formulario (isla). Después la dirección, el
// horario y el mapa (de la BD) y la cotización para eventos.
import ContactForm from '../islands/ContactForm'
import BaseLayout from '../layouts/BaseLayout.astro'
import VisitSection from './home/VisitSection.astro'
import QuoteCta from './QuoteCta.astro'
import { getSiteContent, getStoreInfo } from '../lib/catalog'
import { contentImage } from '../lib/home'
import { localizedPath, messagesFor, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const [c, store] = await Promise.all([getSiteContent(locale), getStoreInfo()])
const title = c['contact.title'] ?? t(locale, 'nav.contact')
const SOCIAL_NAMES = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', x: 'X' } as const
const image = contentImage(c['contact.image'])

interface Quick {
  href: string
  label: string
  value: string
  hint: string
  icon: string
  external: boolean
}

// Íconos decorativos: cada tarjeta ya dice en texto qué es.
const quick: Quick[] = []
if (store.phone)
  quick.push({
    href: `tel:${store.phone}`,
    label: t(locale, 'contact.call'),
    value: store.phone,
    hint: t(locale, 'contact.call_hint'),
    icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
    external: false,
  })
if (store.whatsapp)
  quick.push({
    href: `https://wa.me/${store.whatsapp}`,
    label: t(locale, 'contact.whatsapp'),
    value: t(locale, 'contact.whatsapp_cta'),
    hint: t(locale, 'contact.whatsapp_hint'),
    icon: 'M4 20l1.3-3.9A8 8 0 1 1 8 19.2L4 20ZM9 9.5c.5 2 2.5 4 4.5 4.5l1-1 2 1c-.5 1.5-2 2-3.5 1.5A7 7 0 0 1 8 10.5C7.5 9 8 7.5 9.5 7l1 2-1 1Z',
    external: true,
  })
if (store.email)
  quick.push({
    href: `mailto:${store.email}`,
    label: t(locale, 'contact.email'),
    value: store.email,
    hint: t(locale, 'contact.email_hint'),
    icon: 'M3 6h18v12H3zM3 7l9 6 9-6',
    external: false,
  })
---

<BaseLayout locale={locale} title={title} description={c['contact.lead']}>
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 pb-16 pt-12 md:px-8 md:pt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:pb-24"
  >
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h1 class="font-heading text-5xl font-bold tracking-tight md:text-7xl">{title}</h1>
      {
        c['contact.lead'] && (
          <p class="mt-5 max-w-2xl text-xl leading-relaxed text-muted">{c['contact.lead']}</p>
        )
      }
      {
        quick.length > 0 && (
          <>
            <h2 class="mt-10 text-sm font-semibold uppercase tracking-wider text-muted">
              {t(locale, 'contact.quick_title')}
            </h2>
            <ul class="mt-4 grid gap-3">
              {quick.map((q) => (
                <li>
                  <a
                    href={q.href}
                    target={q.external ? '_blank' : undefined}
                    rel={q.external ? 'noopener noreferrer' : undefined}
                    class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm transition-transform hover:ring-1 hover:ring-secondary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary motion-safe:hover:-translate-y-0.5"
                  >
                    <span
                      class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-sage-soft text-sage-ink"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        class="size-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={q.icon} />
                      </svg>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm text-muted">{q.label}</span>
                      <span class="block break-words font-semibold">{q.value}</span>
                      <span class="block text-xs text-muted">{q.hint}</span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="text-secondary transition-transform motion-safe:group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        store.socials.length > 0 && (
          <>
            <h2 class="mt-8 text-sm font-semibold uppercase tracking-wider text-muted">
              {t(locale, 'contact.follow')}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-3">
              {store.socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center rounded-full border border-dark/15 bg-white px-5 font-medium hover:border-secondary"
                  >
                    {SOCIAL_NAMES[s.network]}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        image && (
          <div class="mt-8 hidden h-64 overflow-hidden rounded-[28px] bg-sage-soft lg:block">
            <img src={image} alt="" loading="lazy" class="size-full object-cover" />
          </div>
        )
      }
    </div>
    <ContactForm
      client:load
      locale={locale}
      messages={messagesFor(locale)}
      turnstileSiteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
      privacyHref={localizedPath('/privacy', locale)}
    />
  </div>
  <!-- WhatsApp y correo ya están arriba: aquí van la dirección, el horario, el teléfono y el mapa -->
  <VisitSection locale={locale} c={c} store={store} />
  <div class="mx-auto max-w-7xl px-4 pb-20 md:px-8 md:pb-28">
    <QuoteCta locale={locale} />
  </div>
</BaseLayout>

<script>
  import '../scripts/home-motion'
</script>
