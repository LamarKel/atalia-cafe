{
  "name": "atalia-cafe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @atalia/web dev",
    "dev:api": "pnpm --filter @atalia/api dev",
    "dev:admin": "pnpm --filter @atalia/admin dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "node db/tests/run-pglite.mjs node_modules",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:db"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
